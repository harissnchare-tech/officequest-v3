# === HARISS OfficeQuest V3 — Variables d'environnement ===
# Copiez ce fichier en ".env" et remplissez les valeurs réelles.
# Ne jamais commiter le fichier .env sur GitHub.

# Port sur lequel le serveur Express écoute
PORT=3000

# Environnement d'exécution : development | production
NODE_ENV=development

# URL de connexion à la base de données PostgreSQL
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://user:password@localhost:5432/hariss_officequest

# Clé secrète utilisée pour signer les tokens JWT (utilisez une chaîne longue et aléatoire)
JWT_SECRET=change_this_secret_key_in_production

# Durée de validité des tokens JWT
JWT_EXPIRES_IN=7d
